# ──────────────────────────────────────────────────────────────
# Google Sheets Database — CờViệt Landing Page
# Sao chép file này thành .env.local và điền thông tin thật vào
# ──────────────────────────────────────────────────────────────

# Email của Service Account (lấy từ Google Cloud Console)
# Ví dụ: co-viet@my-project-123456.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Private key của Service Account (giữ nguyên cả -----BEGIN/END-----)
# Lưu ý: thay tất cả dấu xuống dòng thật bằng \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ID của Google Sheet (lấy từ URL: spreadsheets/d/[SHEET_ID]/edit)
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
